# Leave secrets empty — the first-run wizard generates/collects them.
# Never commit a filled .env. Copying this file alone must NOT produce a login-ready panel.
BOT_TOKEN=""
BOT_USERNAME=""
ADMIN_IDS=""
PG_BASE_URL=""
# Subscription route configured in PasarGuard (e.g. /apilog instead of /sub).
PG_SUBSCRIPTION_PATH="/sub"
PG_USERNAME=""
PG_PASSWORD=""
# Optional: skip login and use a ready token
# PG_ACCESS_TOKEN=""
# Set to 1 to reject private/loopback PG_BASE_URL (strict SSRF mode).
# Default allows LAN/loopback panels (common same-host PasarGuard installs).
# PG_URL_PUBLIC_ONLY="0"

WEB_HOST="0.0.0.0"
WEB_PORT="9000"
# Auto-generated on first start if empty/placeholder
WEB_SECRET=""
WEB_ADMIN_USER="admin"
# Set only via wizard or: python -m scripts.set_web_password
WEB_ADMIN_PASSWORD=""

# Single runtime DB URL (not dual-path). Fresh installs auto-provision PostgreSQL.
# Override before install for managed/remote Postgres:
#   export PGCLOCK_DATABASE_URL="postgresql+asyncpg://user:pass@host:5432/db"
# Manual local provision: sudo bash scripts/setup_postgres.sh
DATABASE_URL="postgresql+asyncpg://pgclock:CHANGE_ME@127.0.0.1:5432/pgclock"
# PostgreSQL connection pool (defaults 10 and 20; 1–100). Keep the sum below Postgres max_connections.
#DB_POOL_SIZE="10"
#DB_MAX_OVERFLOW="20"

# Leave empty for polling. Set full https URL for webhook mode.
WEBHOOK_URL=""
WEBHOOK_PATH="/telegram/webhook"
# Optional: Telegram webhook secret. Auto-generated into data/webhook_secret.token if empty.
# WEBHOOK_SECRET_TOKEN=""

# Public https base for Mini App (e.g. https://bot.example.com). Empty = chat-only UX.
PUBLIC_BASE_URL=""

# Optional public docs site (e.g. https://docs.example.com). Empty = in-panel /help/
DOCS_BASE_URL=""

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-*.
TRUST_PROXY="0"
# Number of trusted reverse-proxy hops directly in front of this app (e.g. 1 for
# a single nginx in front). The client IP is taken from the X-Forwarded-For
# entry counted from the RIGHT by this many hops — never the left-most entry,
# which any client can spoof. Only relevant when TRUST_PROXY=1.
TRUST_PROXY_HOPS="1"

CURRENCY="Toman"
DEFAULT_LOCALE="fa"

# Preferred update channel for checks/deploy: main (stable / پایدار) or dev (توسعه).
# Change from Settings → Update tab.
UPDATE_CHANNEL="main"
# Actually installed channel tip — header badge (پایدار/توسعه) follows this only.
# Updated automatically after a successful panel update.
DEPLOYED_CHANNEL="main"
